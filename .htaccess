DirectoryIndex Home.php
Options -Indexes

# ── Dedicated admin namespace (URL alias — no files are moved) ────────
#   http://localhost/udmp_adama_rental_house/admin/            -> admin dashboard
#   http://localhost/udmp_adama_rental_house/admin/<file>      -> that file in the root
# This is ONLY a URL convenience. Every target PHP file still enforces
# authorization server-side (admin_meets_level() in includes/security.php),
# so this path is not a security mechanism on its own. The original flat
# URLs (e.g. /admin_panel.php) keep working unchanged.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /admin  or  /admin/   ->  the admin dashboard
    RewriteRule ^admin/?$ admin_panel.php [L,QSA]

    # /admin/<anything>     ->  the matching file in the project root.
    # Relative redirects (Location: login.php etc.) and includes keep
    # working because they resolve inside the /admin/ namespace too.
    RewriteRule ^admin/(.+)$ $1 [L,QSA]
</IfModule>

# ── Security Headers ──────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Dynamic pages must never be replayed from cache with a stale form or
    # CSRF token (back button / bfcache after a login or logout).
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# Guard sensitive/config files from direct web access (server-side include() still works).
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|log|lock)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(config_secrets|config_secrets\.example|db|session_config|mail_helper|security|payments)\.php$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(setup|installed\.lock)">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|log|lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^(config_secrets|config_secrets\.example|db|session_config|mail_helper|security|payments)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^(setup|installed\.lock)">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>